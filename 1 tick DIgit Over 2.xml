# Class to store and analyze price data and indicators
class MarketAnalyzer:
    """Analyzes market data and calculates indicators for trading decisions."""
    
    def __init__(self, config):
        """Initialize market analyzer with configuration.
        
        Args:
            config: Bot configuration object
        """
        self.config = config
        self.prices = []
        self.timestamps = []
        self.digits = []
        self.digit_history = deque(maxlen=config.DIGIT_HISTORY_SIZE)
        self.wins = 0
        self.losses = 0
        self.consecutive_losses = 0
        self.last_prediction = None
        self.last_result = None
        
        # Initialize indicator values
        self.fast_sma = None
        self.slow_sma = None
        self.rsi = None
        
        # Debug tracking
        self.last_tick_time = None
        self.tick_intervals = []
    
    def add_tick(self, price, timestamp=None):
        """Add a new price tick and update all indicators.
        
        Args:
            price: Current price
            timestamp: Optional timestamp of the tick
        """
        if timestamp is None:
            timestamp = time.time()
            
        # Calculate tick intervals for debugging
        if self.config.DEBUG and self.last_tick_time is not None:
            interval = timestamp - self.last_tick_time
            self.tick_intervals.append(interval)
            # Keep only recent intervals
            if len(self.tick_intervals) > 100:
                self.tick_intervals = self.tick_intervals[-100:]
                
        self.last_tick_time = timestamp
        
        # Store price and timestamp
        self.prices.append(price)
        self.timestamps.append(timestamp)
        
        # Extract digit from price
        last_digit = self._extract_digit(price)
        self.digits.append(last_digit)
        self.digit_history.append(last_digit)
        
        # Keep only recent prices to manage memory
        max_history = max(200, 
                          self.config.SLOW_SMA_PERIOD * 2, 
                          self.config.RSI_PERIOD * 2)
        if len(self.prices) > max_history:
            self.prices = self.prices[-max_history:]
            self.timestamps = self.timestamps[-max_history:]
            self.digits = self.digits[-max_history:]
            
    def _extract_digit(self, price):
        """Extract the last digit from a price.
        
        Args:
            price: The price value
            
        Returns:
            int: The last digit after the decimal point
        """
        # For a price like 123.45, this extracts the '5'
        # Multiply by 10, round to nearest int to get the digit after decimal
        return int((float(price) * 10) % 10)
    
    def calculate_indicators(self):
        """Calculate all technical indicators needed for strategy.
        
        Returns:
            bool: True if indicators were calculated successfully, False otherwise
        """
        min_data_required = max(self.config.SLOW_SMA_PERIOD, self.config.RSI_PERIOD)
        if len(self.prices) < min_data_required:
            logging.debug(f"Not enough data for indicators: {len(self.prices)}/{min_data_required}")
            return False  # Not enough data
            
        # Convert prices to numpy array for technical analysis
        price_array = np.array(self.prices, dtype=float)
        
        try:
            # Calculate SMAs
            self.fast_sma = talib.SMA(price_array, timeperiod=self.config.FAST_SMA_PERIOD)[-1]
            self.slow_sma = talib.SMA(price_array, timeperiod=self.config.SLOW_SMA_PERIOD)[-1]
            
            # Calculate RSI
            self.rsi = talib.RSI(price_array, timeperiod=self.config.RSI_PERIOD)[-1]
            
            if self.config.DEBUG:
                logging.debug(f"Indicators: Fast SMA: {self.fast_sma:.4f}, "
                            f"Slow SMA: {self.slow_sma:.4f}, RSI: {self.rsi:.2f}")
            
            return True
        except Exception as e:
            logging.error(f"Error calculating indicators: {str(e)}")
            return False
    
    def analyze_digit_distribution(self):
        """Analyze recent digit distribution to identify patterns.
        
        Returns:
            tuple: (optimal_bias, optimal_threshold) for trading decision
        """
        # Need minimum sample size for meaningful analysis
        if len(self.digit_history) < self.config.MIN_SAMPLE_SIZE:
            if self.config.DEBUG:
                logging.debug(f"Not enough digit history: {len(self.digit_history)}/{self.config.MIN_SAMPLE_SIZE}")
            return (0.5, 5)  # Neutral bias, default threshold
        
        # Count frequency of each digit
        digit_counter = Counter(self.digit_history)
        
        # Calculate probabilities for each digit
        total_samples = len(self.digit_history)
        digit_probs = {digit: count/total_samples for digit, count in digit_counter.items()}
        
        # Calculate probability of digit being over or under thresholds
        over_probs = {}
        under_probs = {}
        
        for threshold in range(10):
            over_prob = sum(digit_probs.get(d, 0) for d in range(threshold+1, 10))
            under_prob = sum(digit_probs.get(d, 0) for d in range(0, threshold))
            over_probs[threshold] = over_prob
            under_probs[threshold] = under_prob
        
        # Find the threshold with maximum bias (furthest from 0.5)
        max_bias = 0
        optimal_threshold = 4  # Default from original strategy
        optimal_bias = 0.5
        
        for threshold in range(1, 9):  # Exclude extremes 0 and 9
            over_bias = abs(over_probs[threshold] - 0.5)
            under_bias = abs(under_probs[threshold] - 0.5)
            
            if over_bias > max_bias:
                max_bias = over_bias
                optimal_threshold = threshold
                optimal_bias = over_probs[threshold]
            
            if under_bias > max_bias:
                max_bias = under_bias
                optimal_threshold = threshold
                optimal_bias = under_probs[threshold]
        
        if self.config.DEBUG:
            digit_dist = ", ".join([f"{d}:{digit_counter.get(d, 0)}" for d in range(10)])
            logging.debug(f"Digit distribution: {digit_dist}")
            logging.debug(f"Optimal threshold: {optimal_threshold} with bias: {optimal_bias:.4f}")
        
        return (optimal_bias, optimal_threshold)
    
    def determine_contract_type(self, bias, threshold):
        """Determine whether to use DIGITOVER or DIGITUNDER based on bias.
        
        Args:
            bias: The probability bias (0-1)
            threshold: The digit threshold
            
        Returns:
            tuple: (contract_type, threshold) for trading
        """
        if bias > 0.5:
            return "DIGITOVER", threshold
        else:
            return "DIGITUNDER", threshold
    
    def check_uptrend(self):
        """Check if price is in an uptrend.
        
        Returns:
            bool: True if price is in uptrend, False otherwise
        """
        if len(self.prices) < self.config.SLOW_SMA_PERIOD or self.fast_sma is None:
            return False
            
        current_price = float(self.prices[-1])
        return current_price > self.fast_sma
    
    def check_indicators_aligned(self):
        """Check if all indicators align for a high-quality signal.
        
        Returns:
            bool: True if indicators are aligned, False otherwise
        """
        if self.fast_sma is None or self.slow_sma is None or self.rsi is None:
            return False
            
        # Fast SMA should be above Slow SMA (strong uptrend)
        sma_aligned = self.fast_sma > self.slow_sma
        
        # RSI should be in the sweet spot (not oversold or overbought)
        rsi_aligned = self.config.RSI_LOWER < self.rsi < self.config.RSI_UPPER
        
        if self.config.DEBUG:
            logging.debug(f"Indicators aligned: SMAs: {sma_aligned}, RSI: {rsi_aligned}")
            
        return sma_aligned and rsi_aligned
    
    def calculate_signal_quality(self, bias):
        """Calculate overall signal quality score (0-1).
        
        Args:
            bias: The digit bias probability
            
        Returns:
            float: Signal quality score between 0 and 1
        """
        # Base factors
        trend_quality = 1.0 if self.check_uptrend() else 0.0
        indicator_quality = 1.0 if self.check_indicators_aligned() else 0.5
        
        # Digit bias quality (how far from 0.5 is the bias, normalized to 0-1)
        bias_quality = abs(bias - 0.5) * 2  # Convert 0-0.5 range to 0-1 range
        
        # Win rate quality (higher recent win % = higher quality)
        total_trades = self.wins + self.losses
        if total_trades > 0:
            win_rate = self.wins / total_trades
            win_rate_quality = min(win_rate * 1.5, 1.0)  # Scale win rate, cap at 1.0
        else:
            win_rate_quality = 0.5  # Neutral if no trades
            
        # Recent performance factor
        if self.last_result == "win":
            recency_factor = 1.1  # Slight boost after a win
        elif self.consecutive_losses > 2:
            recency_factor = 0.8  # Penalty after multiple losses
        else:
            recency_factor = 1.0  # Neutral
            
        # Calculate final score with weightings
        weights = {
            'trend': 0.25,
            'indicators': 0.25,
            'bias': 0.3,
            'win_rate': 0.2
        }
        
        score = (
            weights['trend'] * trend_quality +
            weights['indicators'] * indicator_quality +
            weights['bias'] * bias_quality +
            weights['win_rate'] * win_rate_quality
        ) * recency_factor
        
        final_score = min(score, 1.0)  # Cap at 1.0
        
        if self.config.DEBUG:
            logging.debug(f"Signal quality: {final_score:.4f} (Trend: {trend_quality}, "
                        f"Indicators: {indicator_quality}, Bias: {bias_quality:.4f}, "
                        f"Win rate: {win_rate_quality:.4f}, Factor: {recency_factor})")
            
        return final_score
    
    def update_trade_result(self, result):
        """Update win/loss statistics after a trade.
        
        Args:
            result: "win" or "loss"
        """
        if result == "win":
            self.wins += 1
            self.consecutive_losses = 0
            self.last_result = "win"
        else:
            self.losses += 1
            self.consecutive_losses += 1
            self.last_result = "loss"
    
    def get_stats(self):
        """Get statistics about the market analysis.
        
        Returns:
            dict: Statistical information
        """
        total_trades = self.wins + self.losses
        win_rate = (self.wins / total_trades * 100) if total_trades > 0 else 0
        
        # Calculate tick frequency if available
        tick_frequency = None
        if len(self.tick_intervals) > 0:
            avg_interval = sum(self.tick_intervals) / len(self.tick_intervals)
            if avg_interval > 0:
                tick_frequency = 1.0 / avg_interval
        
        return {
            "total_ticks": len(self.prices),
            "digit_history_size": len(self.digit_history),
            "wins": self.wins,
            "losses": self.losses,
            "total_trades": total_trades,
            "win_rate": win_rate,
            "consecutive_losses": self.consecutive_losses,
            "tick_frequency": tick_frequency
        }


# Money Management System
class MoneyManager:
    """Handles stake sizing and profit/loss tracking."""
    
    def __init__(self, config):
        """Initialize money manager with configuration.
        
        Args:
            config: Bot configuration object
        """
        self.config = config
        self.current_stake = config.INITIAL_STAKE
        self.total_profit = Decimal('0')
        self.highest_balance = Decimal('0')
        self.lowest_balance = Decimal('0')
        self.max_drawdown = Decimal('0')
        self.trades = 0
        self.balance_history = []
        self.stake_history = []
    
    def calculate_stake(self, signal_quality, consecutive_losses):
        """Calculate stake size based on signal quality and loss streak.
        
        Args:
            signal_quality: Quality score of the signal (0-1)
            consecutive_losses: Number of consecutive losses
            
        Returns:
            Decimal: The calculated stake amount
        """
        # Reset to initial stake after wins
        if consecutive_losses == 0:
            self.current_stake = self.config.INITIAL_STAKE
        else:
            # Apply martingale, but adjust based on signal quality
            quality_factor = Decimal(str(max(0.5, signal_quality)))  # Even poor signals get at least 0.5 factor
            martingale_multiple = self.config.MARTINGALE_FACTOR ** consecutive_losses
            
            # Adjust multiple based on signal quality
            adjusted_multiple = martingale_multiple * quality_factor
            
            # Calculate new stake (round down to 2 decimal places)
            self.current_stake = (self.config.INITIAL_STAKE * adjusted_multiple).quantize(
                Decimal('0.01'), rounding=ROUND_DOWN)
            
            # Apply maximum stake limit
            self.current_stake = min(self.current_stake, self.config.MAX_STAKE)
            
        # Add to stake history
        self.stake_history.append(float(self.current_stake))
        
        # Keep history manageable
        if len(self.stake_history) > 100:
            self.stake_history = self.stake_history[-100:]
            
        if self.config.DEBUG:
            logging.debug(f"Calculated stake: {self.current_stake} (Losses: {consecutive_losses}, "
                        f"Quality: {signal_quality:.4f})")
            
        return self.current_stake
    
    def update_balance(self, profit):
        """Update balance and statistics after a trade.
        
        Args:
            profit: Profit or loss amount from the trade
        """
        self.total_profit += profit
        self.trades += 1
        
        # Update balance history
        self.balance_history.append(float(self.total_profit))
        
        # Keep history manageable
        if len(self.balance_history) > 1000:
            self.balance_history = self.balance_history[-1000:]
        
        # Update max drawdown calculations
        if self.total_profit > self.highest_balance:
            self.highest_balance = self.total_profit
        
        if self.total_profit < self.lowest_balance:
            self.lowest_balance = self.total_profit
            
        current_drawdown = self.highest_balance - self.total_profit
        if current_drawdown > self.max_drawdown:
            self.max_drawdown = current_drawdown
            
        if self.config.DEBUG:
            logging.debug(f"Balance update: Profit: {profit}, Total: {self.total_profit}, "
                        f"Drawdown: {current_drawdown}")
    
    def check_target_reached(self):
        """Check if profit target is reached.
        
        Returns:
            bool: True if target reached, False otherwise
        """
        return self.total_profit >= self.config.TARGET_PROFIT
    
    def check_max_loss_exceeded(self):
        """Check if maximum loss is exceeded.
        
        Returns:
            bool: True if max loss exceeded, False otherwise
        """
        return self.total_profit <= -self.config.MAX_LOSS
    
    def get_stats(self):
        """Get money management statistics.
        
        Returns:
            dict: Statistical information
        """
        return {
            "current_stake": float(self.current_stake),
            "total_profit": float(self.total_profit),
            "highest_balance": float(self.highest_balance),
            "lowest_balance": float(self.lowest_balance),
            "max_drawdown": float(self.max_drawdown),
            "trades": self.trades
        }


# Trading Bot class for Deriv API
class DerivDigitBot:
    """Main bot class that handles the trading logic and Deriv API integration."""
    
    def __init__(self, config=None):
        """Initialize the trading bot.
        
        Args:
            config: Bot configuration object (optional)
        """
        self.config = config or Config()
        self.ws = None
        self.analyzer = MarketAnalyzer(self.config)
        self.money_manager = MoneyManager(self.config)
        self.auth_token = None
        self.account_balance = 0
        self.currency = None
        self.active_contract = None
        self.waiting_for_result = False
        self.session_trades = 0
        self.on_break = False
        self.break_until = None
        
        # Statistics
        self.requests_sent = 0
        self.responses_received = 0
        self.last_activity = time.time()
        self.running = False
        
        # Initialize indicators
        self.analyzer.fast_sma = None
        self.analyzer.slow_sma = None
        self.analyzer.rsi = None
        
    def connect(self):
        """Establish WebSocket connection to Deriv API.
        
        Returns:
            bool: True if connection successful, False otherwise
        """
        websocket_url = f"{self.config.API_URL}{self.config.APP_ID}"
        try:
            self.ws = websocket.create_connection(websocket_url)
            logging.info("Connected to Deriv API")
            self.last_activity = time.time()
            return True
        except Exception as e:
            logging.error(f"Connection error: {str(e)}")
            return False
    
    def set_auth_token(self, token):
        """Set the authorization token for API access.
        
        Args:
            token: Deriv API authorization token
        """
        self.auth_token = token
        
    def authorize(self):
        """Authorize using token.
        
        Returns:
            bool: True if authorization successful, False otherwise
        """
        if not self.auth_token:
            logging.error("No authorization token provided")
            return False
            
        auth_req = {
            "authorize": self.auth_token
        }
        
        try:
            self.send_request(auth_req)
            response = self.receive_response()
            
            if "error" in response:
                logging.error(f"Authorization failed: {response['error']['message']}")
                return False
                
            if "authorize" not in response:
                logging.error("Unexpected authorization response")
                return False
                
            logging.info("Authorization successful")
            self.account_balance = response["authorize"]["balance"]
            self.currency = response["authorize"]["currency"]
            logging.info(f"Account balance: {self.account_balance} {self.currency}")
            return True
        except Exception as e:
            logging.error(f"Authorization error: {str(e)}")
            return False
    
    def subscribe_to_ticks(self):
        """Subscribe to price ticks for the selected symbol.
        
        Returns:
            bool: True if subscription successful, False otherwise
        """
        tick_req = {
            "ticks": self.config.SYMBOL,
            "subscribe": 1
        }
        
        try:
            self.send_request(tick_req)
            logging.info(f"Subscribed to {self.config.SYMBOL} ticks")
            return True
        except Exception as e:
            logging.error(f"Tick subscription error: {str(e)}")
            return False
    
    def send_request(self, request):
        """Send a request to the Deriv API.
        
        Args:
            request: Request object to send
            
        Raises:
            Exception: If there's an error sending the request
        """
        if not self.ws:
            raise Exception("WebSocket connection not established")
            
        self.ws.send(json.dumps(request))
        self.requests_sent += 1
        self.last_activity = time.time()
        
        if self.config.DEBUG:
            logging.debug(f"Request sent: {json.dumps(request)}")
    
    def receive_response(self):
        """Receive a response from the Deriv API.
        
        Returns:
            dict: Response object from the API
            
        Raises:
            Exception: If there's an error receiving the response
        """
        if not self.ws:
            raise Exception("WebSocket connection not established")
            
        response = json.loads(self.ws.recv())
        self.responses_received += 1
        self.last_activity = time.time()
        
        if self.config.DEBUG and "tick" not in response:  # Don't log every tick to keep logs manageable
            logging.debug(f"Response received: {json.dumps(response)}")
            
        return response
    
    def buy_contract(self, contract_type, stake, barrier):
        """Place a buy order for a contract.
        
        Args:
            contract_type: Type of contract (e.g., "DIGITOVER")
            stake: Stake amount
            barrier: Barrier value
            
        Returns:
            bool: True if buy request successful, False otherwise
        """
        if self.waiting_for_result:
            logging.info("Waiting for previous contract to complete")
            return False
            
        buy_req = {
            "buy": 1,
            "subscribe": 1,
            "price": float(stake),
            "parameters": {
                "amount": float(stake),
                "basis": "stake",
                "contract_type": contract_type,
                "symbol": self.config.SYMBOL,
                "duration": self.config.DURATION,
                "duration_unit": self.config.DURATION_UNIT,
                "barrier": barrier
            }
        }
        
        try:
            self.send_request(buy_req)
            response = self.receive_response()
            
            if "error" in response:
                logging.error(f"Buy contract failed: {response['error']['message']}")
                return False
                
            if "buy" not in response:
                logging.error("Unexpected buy response")
                return False
                
            self.active_contract = response["buy"]
            self.waiting_for_result = True
            logging.info(f"Bought {contract_type} contract with stake {stake}, barrier {barrier}")
            logging.info(f"Contract ID: {self.active_contract['contract_id']}")
            return True
        except Exception as e:
            logging.error(f"Buy contract error: {str(e)}")
            return False
    
